{
  "name": "cgc-pms-frontend-admin",
  "version": "1.6.0-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "type-check:contracts": "tsc -p ../packages/frontend-contracts/tsconfig.json --noEmit",
    "lint:check": "eslint src tests e2e scripts eslint.config.js playwright.config.ts vite.config.ts vitest.config.ts --ext .vue,.js,.mjs,.ts,.jsx,.tsx",
    "test:unit": "vitest run --dir tests/unit",
    "test:ci": "vitest run --dir tests/unit --reporter=json --outputFile=test-results/unit.json",
    "check:design-system": "vitest run tests/unit/design-system.test.ts tests/unit/v2-ui-remediation-gate.test.ts tests/unit/global-context-contract.test.ts",
    "test:e2e:health": "playwright test e2e/health.spec.ts",
    "test:e2e:contract": "node scripts/run-migration-ui-gate.mjs",
    "test:e2e:live": "pwsh -NoProfile -File ../scripts/demo/complete-project-v2/verify-live-all.ps1",
    "test:e2e:migration-gate": "pnpm test:e2e:contract",
    "check:pre-push": "node scripts/run-push-quality-gate.mjs",
    "check:boundary": "node scripts/check-clean-room-boundary.mjs",
    "generate:route-ledger": "node scripts/generate-route-ledger.mjs --write",
    "check:route-ledger": "node scripts/generate-route-ledger.mjs --check",
    "check:bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@cgc-pms/frontend-contracts": "link:../packages/frontend-contracts",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
