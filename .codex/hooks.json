{
  "description": "Repository hooks for command preflight and deterministic long-task completion checks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.exit(0)\"",
            "commandWindows": "node -e \"const{spawnSync}=require('node:child_process');const path=require('node:path');const git=spawnSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',shell:false});if(git.status!==0)process.exit(2);const guard=path.join(git.stdout.trim(),'.codex','hooks','pre-tool-use-command-guard.ps1');const run=spawnSync('pwsh',['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',guard],{stdio:'inherit',shell:false});process.exit(run.status??2)\"",
            "timeout": 5,
            "statusMessage": "Validating PowerShell command and literal paths"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{spawnSync}=require('node:child_process');const{pathToFileURL}=require('node:url');const path=require('node:path');const git=spawnSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',shell:false});if(git.status!==0)process.exit(git.status||1);process.argv.splice(1,0,'hook-entry');import(pathToFileURL(path.join(git.stdout.trim(),'.agents/skills/long-task-gate/scripts/long-task-gate.mjs')).href).catch(()=>{process.exitCode=1})\" user-prompt",
            "commandWindows": "node -e \"const{spawnSync}=require('node:child_process');const{pathToFileURL}=require('node:url');const path=require('node:path');const git=spawnSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',shell:false});if(git.status!==0)process.exit(git.status||1);process.argv.splice(1,0,'hook-entry');import(pathToFileURL(path.join(git.stdout.trim(),'.agents/skills/long-task-gate/scripts/long-task-gate.mjs')).href).catch(()=>{process.exitCode=1})\" user-prompt",
            "timeout": 5,
            "statusMessage": "Registering explicit long-task completion gate",
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{spawnSync}=require('node:child_process');const{pathToFileURL}=require('node:url');const path=require('node:path');const git=spawnSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',shell:false});if(git.status!==0)process.exit(git.status||1);process.argv.splice(1,0,'hook-entry');import(pathToFileURL(path.join(git.stdout.trim(),'.agents/skills/long-task-gate/scripts/long-task-gate.mjs')).href).catch(()=>{process.exitCode=1})\" stop",
            "commandWindows": "node -e \"const{spawnSync}=require('node:child_process');const{pathToFileURL}=require('node:url');const path=require('node:path');const git=spawnSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',shell:false});if(git.status!==0)process.exit(git.status||1);process.argv.splice(1,0,'hook-entry');import(pathToFileURL(path.join(git.stdout.trim(),'.agents/skills/long-task-gate/scripts/long-task-gate.mjs')).href).catch(()=>{process.exitCode=1})\" stop",
            "timeout": 330,
            "statusMessage": "Checking long-task completion contract"
          }
        ]
      }
    ]
  }
}
